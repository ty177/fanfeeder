# FanFeeder MCP Server — environment variables
# Copy to .env for local development (never commit .env)

# The deployed FanFeeder site (serves teams.json and subscribers_index.json)
FANFEEDER_SITE=https://fanfeeder.fire-exit.com

# Formspree endpoint for subscription writes
FORMSPREE_ENDPOINT=https://formspree.io/f/mzdawwjk

# Transport: "sse" for HTTP server (Railway), "stdio" for local Claude Desktop
MCP_TRANSPORT=sse

# Port to listen on (Railway sets this automatically)
PORT=8000
